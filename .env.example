# ==============================================================================
# KONFIGURASI ENVIRONMENT — KOPDES MERAH PUTIH LADANG LAWEH
# ==============================================================================
# PERINGATAN KEAMANAN:
# 1. Salin file ini menjadi .env.local untuk konfigurasi lokal:
#    copy .env.example .env.local
# 2. Dilarang keras memasukkan kunci rahasia ke repositori Git atau percakapan chat.
# 3. Kunci berawalan NEXT_PUBLIC_ dapat dibaca oleh browser.
# 4. Kunci SERVICE_ROLE_KEY hanya boleh dibaca di server (Server Actions / Route Handlers).
# ==============================================================================

# Identitas Aplikasi
NEXT_PUBLIC_APP_NAME="Kopdes Merah Putih — Ladang Laweh"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Banner prototipe sampai seluruh modul terhubung ke database
NEXT_PUBLIC_DEMO_MODE="true"

# Kunci Akses Privat Server Publik (Opsional - wajib jika dipasang di hosting publik seperti Vercel)
# KOPDES_PRIVATE_ACCESS_KEY="kunci-rahasia-akses-manajer-anda"

# Supabase Basis Data & Autentikasi (Disediakan pada Tahap 09 & 10)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Kunci Server-Only (HANYA untuk Backend / Server Action, DILARANG berawalan NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=""
